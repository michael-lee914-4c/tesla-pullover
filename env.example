# Copy to .env (never commit) or export in your process manager.
# Do not put secrets, tokens, VINs, or private keys in git.

# --- Fleet OAuth (Tesla developer app) ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://your.domain/callback
TESLA_AUDIENCE=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_REGION=na
# Optional explicit Fleet origin. Defaults from TESLA_REGION (na|eu|cn).
# TESLA_FLEET_BASE=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_CACHE_PATH=./token-cache.json

# Optional pre-issued owner token (Teslemetry or a cached Fleet access token).
# If set, OAuth login / token-cache.json is skipped.
# TESLA_ACCESS_TOKEN=

# Default vehicle when tools omit vin. Leave empty and pass vin at call time.
# TESLA_VIN=

# Vehicle-command proxy (tesla-http-proxy or Teslemetry). Required for navigation.
# Keep tesla-http-proxy on localhost only. Do not publish it next to the public MCP URL.
# TESLA_COMMAND_BASE=https://127.0.0.1:4443
# NODE_EXTRA_CA_CERTS=./tls-cert.pem

# --- Geocoding ---
# Google Places / Maps. If unset, Nominatim + Overpass (OSM) is used.
# GOOGLE_MAPS_API_KEY=
# GEOCODE_PROVIDER=auto
# GEOCODE_USER_AGENT=tesla-pullover/0.1 (contact: you@your.domain)

# Pull-over defaults
# PULLOVER_MIN_DISTANCE_M=200
# PULLOVER_MAX_DISTANCE_M=2000
# TESLA_WAKE_WAIT_MS=8000

# --- HTTP MCP (Grok Bot / Cursor Cloud). Not a Fleet or Teslemetry token. ---
# TESLA_MCP_TOKEN=
# TESLA_MCP_HOST=0.0.0.0
# TESLA_MCP_PORT=8787
# MCP_TRANSPORT=http

# Dry-run / unit tests. No live Tesla or geocoder calls.
# TESLA_MOCK=1
